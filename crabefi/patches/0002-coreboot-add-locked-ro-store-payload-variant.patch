diff --git a/crabefi-coreboot/src/ro_store.rs b/crabefi-coreboot/src/ro_store.rs
new file mode 100644
index 0000000..0a2b720
--- /dev/null
+++ b/crabefi-coreboot/src/ro_store.rs
@@ -0,0 +1,276 @@
+//! Read-only, memory-mapped UEFI variable store.
+//!
+//! Locked builds (`locked-ro-store`) keep the EDK2 variable store inside the
+//! BIOS region that coreboot write-protects before the payload runs
+//! (`BOOTMEDIA_LOCK_CONTROLLER` + `BOOTMEDIA_LOCK_WHOLE_RO`). The store is
+//! generated at ROM build time with the platform's PK, KEK, db and
+//! `SecureBootEnable=1` already in it, so CrabEFI never needs to write it.
+//!
+//! This backend therefore:
+//!
+//! * reads the region through the CPU's memory-mapped view of the boot flash
+//!   (no SPI controller driver, no write/erase code path at all);
+//! * reports itself as write-protected, so the variable layer mounts the store
+//!   read-only and never tries to format or compact it;
+//! * fails every program/erase request with `WriteProtected`.
+//!
+//! The region is found by name in the FMAP that coreboot points at through
+//! `LB_TAG_BOOT_MEDIA_PARAMS`. Its bytes are covered by the same flash
+//! protection as the rest of the ROM. In addition the payload is built with
+//! the SHA-256 of the exact store image (`CRABEFI_RO_VARSTORE_SHA256`), and a
+//! region whose contents differ is refused. That binds the key hierarchy to
+//! this payload: with coreboot's CBFS verification the payload, and through
+//! it the store, hang off the same metadata hash.
+
+use crabefi::{StorageBackend, StorageError};
+use sha2::{Digest, Sha256};
+
+use crate::tables;
+
+/// SHA-256 of the store image this payload was built for (64 hex digits).
+const EXPECTED_SHA256: &str = env!(
+    "CRABEFI_RO_VARSTORE_SHA256",
+    "locked-ro-store builds need CRABEFI_RO_VARSTORE_SHA256=<sha256 of the generated store>"
+);
+
+/// Parse [`EXPECTED_SHA256`]; a malformed value is a build error.
+const fn expected_digest() -> [u8; 32] {
+    const fn nibble(c: u8) -> u8 {
+        match c {
+            b'0'..=b'9' => c - b'0',
+            b'a'..=b'f' => c - b'a' + 10,
+            b'A'..=b'F' => c - b'A' + 10,
+            _ => panic!("CRABEFI_RO_VARSTORE_SHA256 is not hex"),
+        }
+    }
+    let hex = EXPECTED_SHA256.as_bytes();
+    assert!(
+        hex.len() == 64,
+        "CRABEFI_RO_VARSTORE_SHA256 must be 64 hex digits"
+    );
+    let mut out = [0u8; 32];
+    let mut i = 0;
+    while i < 32 {
+        out[i] = (nibble(hex[2 * i]) << 4) | nibble(hex[2 * i + 1]);
+        i += 1;
+    }
+    out
+}
+const EXPECTED_DIGEST: [u8; 32] = expected_digest();
+
+/// FMAP area name holding the pre-provisioned variable store.
+pub const REGION_NAME: &[u8] = b"RO_UEFI_VARS";
+
+const FMAP_SIGNATURE: &[u8; 8] = b"__FMAP__";
+/// `signature[8] ver_major ver_minor base:u64 size:u32 name[32] nareas:u16`
+const FMAP_HEADER_LEN: u64 = 56;
+/// `offset:u32 size:u32 name[32] flags:u16`
+const FMAP_AREA_LEN: u64 = 42;
+const FMAP_NAME_LEN: usize = 32;
+/// Upper bound on areas walked, so a malformed FMAP cannot stall boot.
+const FMAP_MAX_AREAS: u16 = 128;
+/// Erase-block granularity of the store layout (EDK2 FV blocks).
+const BLOCK: u32 = 4096;
+
+/// The located store: a CPU-visible, read-only window of `size` bytes.
+pub struct MappedReadOnlyStore {
+    phys_base: u64,
+    size: u32,
+}
+
+/// One CPU-visible window onto the boot flash.
+#[derive(Clone, Copy)]
+struct Window {
+    /// Physical address of flash offset `flash_base`.
+    host_base: u64,
+    /// First flash offset covered by the window.
+    flash_base: u64,
+    /// Window length.
+    size: u64,
+}
+
+/// The CPU-visible mapping of the boot flash, as described by coreboot.
+struct FlashMap {
+    windows: heapless::Vec<Window, { tables::MAX_FLASH_MMAP_WINDOWS + 1 }>,
+}
+
+impl FlashMap {
+    /// Physical address for `[offset, offset + len)`, if one window holds all of it.
+    fn phys(&self, offset: u64, len: u64) -> Option<u64> {
+        self.windows.iter().find_map(|window| {
+            let relative = offset.checked_sub(window.flash_base)?;
+            let end = relative.checked_add(len)?;
+            (end <= window.size).then(|| window.host_base + relative)
+        })
+    }
+
+    fn read(&self, offset: u64, buffer: &mut [u8]) -> Option<()> {
+        let phys = self.phys(offset, buffer.len() as u64)?;
+        read_mapped(phys, buffer);
+        Some(())
+    }
+}
+
+/// Byte-wise volatile copy out of the flash mapping.
+fn read_mapped(phys: u64, buffer: &mut [u8]) {
+    for (index, byte) in buffer.iter_mut().enumerate() {
+        // SAFETY: callers only pass ranges validated against coreboot's
+        // description of the memory-mapped boot flash, which is identity
+        // mapped by the payload entry code. Volatile byte reads keep the
+        // compiler from merging or eliding accesses to the decode window.
+        *byte = unsafe { core::ptr::read_volatile((phys + index as u64) as *const u8) };
+    }
+}
+
+fn le16(bytes: &[u8], at: usize) -> u16 {
+    u16::from_le_bytes([bytes[at], bytes[at + 1]])
+}
+
+fn le32(bytes: &[u8], at: usize) -> u32 {
+    u32::from_le_bytes([bytes[at], bytes[at + 1], bytes[at + 2], bytes[at + 3]])
+}
+
+fn name_is(field: &[u8], wanted: &[u8]) -> bool {
+    let len = field.iter().position(|&b| b == 0).unwrap_or(field.len());
+    &field[..len] == wanted
+}
+
+/// Collect the flash mapping coreboot described. SPI flash mmap windows are
+/// exact; without them, x86 decodes the end of the boot medium just below
+/// 4 GiB.
+fn flash_map(info: &tables::CorebootInfo) -> Option<(FlashMap, u64)> {
+    let boot_media = info.boot_media?;
+    let mut windows = heapless::Vec::new();
+    if let Some(spi) = info.spi_flash.as_ref() {
+        for window in spi.mmap_windows.iter() {
+            let _ = windows.push(Window {
+                host_base: u64::from(window.host_base),
+                flash_base: u64::from(window.flash_base),
+                size: u64::from(window.size),
+            });
+        }
+    }
+    if windows.is_empty() {
+        let size = boot_media.boot_media_size;
+        let _ = windows.push(Window {
+            host_base: 0x1_0000_0000u64.checked_sub(size)?,
+            flash_base: 0,
+            size,
+        });
+    }
+    Some((FlashMap { windows }, boot_media.fmap_offset))
+}
+
+impl MappedReadOnlyStore {
+    /// Find [`REGION_NAME`] in the FMAP and check that the whole region is
+    /// readable through the flash mapping.
+    pub fn locate(info: &tables::CorebootInfo) -> Option<Self> {
+        let Some((map, fmap_offset)) = flash_map(info) else {
+            log::error!("RO varstore: coreboot did not describe the boot media mapping");
+            return None;
+        };
+
+        let mut header = [0u8; FMAP_HEADER_LEN as usize];
+        if map.read(fmap_offset, &mut header).is_none() || &header[..8] != FMAP_SIGNATURE {
+            log::error!("RO varstore: no FMAP at flash offset {:#x}", fmap_offset);
+            return None;
+        }
+        let nareas = le16(&header, 54).min(FMAP_MAX_AREAS);
+
+        for index in 0..u64::from(nareas) {
+            let mut area = [0u8; FMAP_AREA_LEN as usize];
+            let at = fmap_offset + FMAP_HEADER_LEN + index * FMAP_AREA_LEN;
+            map.read(at, &mut area)?;
+            if !name_is(&area[8..8 + FMAP_NAME_LEN], REGION_NAME) {
+                continue;
+            }
+            let offset = u64::from(le32(&area, 0));
+            let size = le32(&area, 4);
+            if size == 0 || !size.is_multiple_of(BLOCK) || !offset.is_multiple_of(u64::from(BLOCK))
+            {
+                log::error!(
+                    "RO varstore: FMAP area has unusable geometry ({:#x}+{:#x})",
+                    offset,
+                    size
+                );
+                return None;
+            }
+            let Some(phys_base) = map.phys(offset, u64::from(size)) else {
+                log::error!(
+                    "RO varstore: area {:#x}+{:#x} is outside the flash mapping",
+                    offset,
+                    size
+                );
+                return None;
+            };
+            let mut hasher = Sha256::new();
+            let mut chunk = [0u8; 512];
+            for at in (0..u64::from(size)).step_by(chunk.len()) {
+                read_mapped(phys_base + at, &mut chunk);
+                hasher.update(chunk);
+            }
+            let digest: [u8; 32] = hasher.finalize().into();
+            if digest != EXPECTED_DIGEST {
+                log::error!(
+                    "RO varstore: contents do not match the store this payload was built for \
+                     (sha256 {:02x?}..., expected {})",
+                    &digest[..8],
+                    EXPECTED_SHA256
+                );
+                return None;
+            }
+            log::info!(
+                "RO varstore: '{}' at flash {:#x} (phys {:#x}), {} KiB, read-only",
+                core::str::from_utf8(REGION_NAME).unwrap_or("?"),
+                offset,
+                phys_base,
+                size / 1024
+            );
+            return Some(Self { phys_base, size });
+        }
+
+        log::error!("RO varstore: FMAP has no RO_UEFI_VARS area");
+        None
+    }
+}
+
+impl StorageBackend for MappedReadOnlyStore {
+    fn name(&self) -> &str {
+        "RO_UEFI_VARS (mapped, read-only)"
+    }
+
+    fn size(&self) -> u32 {
+        self.size
+    }
+
+    fn program_granularity(&self) -> u32 {
+        1
+    }
+
+    fn erase_granularity(&self) -> u32 {
+        BLOCK
+    }
+
+    fn is_write_protected(&self) -> bool {
+        true
+    }
+
+    fn read(&mut self, offset: u32, buffer: &mut [u8]) -> Result<(), StorageError> {
+        let end = u64::from(offset)
+            .checked_add(buffer.len() as u64)
+            .ok_or(StorageError::InvalidArgument)?;
+        if end > u64::from(self.size) {
+            return Err(StorageError::InvalidArgument);
+        }
+        read_mapped(self.phys_base + u64::from(offset), buffer);
+        Ok(())
+    }
+
+    fn program(&mut self, _offset: u32, _data: &[u8]) -> Result<(), StorageError> {
+        Err(StorageError::WriteProtected)
+    }
+
+    fn erase(&mut self, _offset: u32, _size: u32) -> Result<(), StorageError> {
+        Err(StorageError::WriteProtected)
+    }
+}
