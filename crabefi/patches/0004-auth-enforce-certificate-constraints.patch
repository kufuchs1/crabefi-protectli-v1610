@@ -925,6 +992,95 @@ mod fixture_tests {
     /// serial: must never be accepted when CA is the trust anchor.
     const FORGED_CA: &[u8] = include_bytes!("../../../../crabefi-pkcs7/testdata/forged_ca.der");
 
+    const SECURITY_ROOT: &[u8] = include_bytes!("testdata/security-root.der");
+    const SECURITY_INTERMEDIATE: &[u8] = include_bytes!("testdata/security-intermediate.der");
+    const SECURITY_SUBCA: &[u8] = include_bytes!("testdata/security-subca.der");
+    const SECURITY_LEAF: &[u8] = include_bytes!("testdata/security-leaf.der");
+    const SECURITY_BAD_KU: &[u8] = include_bytes!("testdata/security-badku.der");
+
+    #[test]
+    fn security_rejects_unknown_critical_certificate_constraints() {
+        let config = ChainBuildingConfig {
+            check_validity_period: false,
+            ..ChainBuildingConfig::default()
+        };
+        assert!(
+            build_and_verify_chain(
+                include_bytes!("testdata/security-critical.der"),
+                SECURITY_ROOT,
+                &[],
+                &config,
+            )
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn security_enforces_code_signing_extended_key_usage() {
+        assert_ne!(
+            verify_pkcs7_signature(
+                include_bytes!("testdata/security-eku.p7"),
+                b"CrabEFI security regression data\n",
+                include_bytes!("testdata/security-eku.der"),
+                true,
+            ),
+            Ok(true)
+        );
+        assert_eq!(
+            verify_pkcs7_signature(
+                include_bytes!("testdata/security-leaf.p7"),
+                b"CrabEFI security regression data\n",
+                SECURITY_LEAF,
+                true,
+            ),
+            Ok(true)
+        );
+    }
+
+    #[test]
+    fn security_rejects_signer_without_digital_signature_usage() {
+        assert_ne!(
+            verify_pkcs7_signature(
+                include_bytes!("testdata/security-badku.p7"),
+                b"CrabEFI security regression data\n",
+                SECURITY_BAD_KU,
+                true,
+            ),
+            Ok(true),
+        );
+    }
+
+    #[test]
+    fn security_enforces_intermediate_path_length() {
+        let config = ChainBuildingConfig {
+            check_validity_period: false,
+            check_revocation: false,
+            ..ChainBuildingConfig::default()
+        };
+        // All signatures are genuine, but pathlen:0 forbids the subordinate CA.
+        assert!(
+            build_and_verify_chain(
+                SECURITY_LEAF,
+                SECURITY_ROOT,
+                &[SECURITY_SUBCA, SECURITY_INTERMEDIATE],
+                &config,
+            )
+            .is_err()
+        );
+        // The same chain with the intermediate explicitly trusted is permitted:
+        // constraints on an enrolled anchor do not restrict that explicit trust.
+        assert!(build_and_verify_chain(SECURITY_LEAF, SECURITY_SUBCA, &[], &config,).is_ok());
+        let invalid_chain = CertificateChain {
+            certificates: vec![
+                SECURITY_LEAF.to_vec(),
+                SECURITY_SUBCA.to_vec(),
+                SECURITY_INTERMEDIATE.to_vec(),
+                SECURITY_ROOT.to_vec(),
+            ],
+        };
+        assert!(verify_certificate_chain(&invalid_chain, &config).is_err());
+    }
+
