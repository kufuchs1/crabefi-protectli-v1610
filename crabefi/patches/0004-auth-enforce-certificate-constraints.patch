 mod tests {
     use super::*;
 
+    /// Exercise the production verifier with an independently supplied real EFI
+    /// binary. Run alone: this test owns the process-global db and dbx caches.
+    #[cfg(feature = "secure-boot")]
+    #[test]
+    #[ignore = "set CRABEFI_TEST_IMAGE and CRABEFI_TEST_CERT (DER), run with --ignored --test-threads=1"]
+    fn security_external_signed_image_and_tampering() {
+        use crate::efi::auth::{KeyDatabaseEntry, db_database, dbx_database};
+        use crabefi_efi_types::secure_boot::EFI_CERT_X509_GUID;
+        let mut image = std::fs::read(std::env::var("CRABEFI_TEST_IMAGE").unwrap()).unwrap();
+        let cert = std::fs::read(std::env::var("CRABEFI_TEST_CERT").unwrap()).unwrap();
+        dbx_database().clear();
+        db_database().clear();
+        // An untrusted signed image must not boot.
+        assert_eq!(verify_pe_image_secure_boot(&image), Ok(false));
+        db_database()
+            .add_entry(KeyDatabaseEntry {
+                cert_type: EFI_CERT_X509_GUID,
+                data: cert.clone(),
+                owner: [0; 16],
+            })
+            .unwrap();
+        assert_eq!(verify_pe_image_secure_boot(&image), Ok(true));
+        let info = parse_pe_for_hash(&image).unwrap();
+        let at = info
+            .sections
+            .iter()
+            .find(|s| s.size_of_raw_data != 0)
+            .unwrap()
+            .file_offset as usize;
+        image[at] ^= 1;
+        assert_ne!(verify_pe_image_secure_boot(&image), Ok(true));
+        image[at] ^= 1;
+        // dbx takes precedence over an enrolled db signer.
+        dbx_database()
+            .add_entry(KeyDatabaseEntry {
+                cert_type: EFI_CERT_X509_GUID,
+                data: cert,
+                owner: [0; 16],
+            })
+            .unwrap();
+        assert_eq!(verify_pe_image_secure_boot(&image), Ok(false));
+        db_database().clear();
+        dbx_database().clear();
+    }
+
