+/// Fail closed on certificate constraints this verifier does not implement.
+/// In particular, silently ignoring critical nameConstraints would allow an
+/// intermediate to delegate beyond the authority granted by its issuer.
+fn validate_certificate_policy(cert_der: &[u8]) -> Result<(), AuthError> {
+    use crabefi_pkcs7::der::Tlv;
+    const EXTENDED_KEY_USAGE: &[u8] = &[0x55, 0x1d, 0x25];
+    const CODE_SIGNING: &[u8] = &[0x2b, 0x06, 0x01, 0x05, 0x05, 0x07, 0x03, 0x03];
+    const ANY_KEY_USAGE: &[u8] = &[0x55, 0x1d, 0x25, 0x00];
+    let cert = parse_cert_view(cert_der)?;
+    for (index, extension) in cert.extensions.iter().enumerate() {
+        if cert
+            .extensions
+            .iter()
+            .take(index)
+            .any(|previous| previous.oid == extension.oid)
+        {
+            return Err(AuthError::CertificateParseError);
+        }
+        if extension.critical
+            && extension.oid != oid::BASIC_CONSTRAINTS
+            && extension.oid != oid::KEY_USAGE
+            && extension.oid != EXTENDED_KEY_USAGE
+        {
+            return Err(AuthError::CertificateParseError);
+        }
+        if extension.oid == EXTENDED_KEY_USAGE {
+            let mut allowed = false;
+            for purpose in Tlv::parse(extension.value)?.contents(tag::SEQUENCE)? {
+                let purpose = purpose?.oid()?;
+                allowed |= purpose == CODE_SIGNING || purpose == ANY_KEY_USAGE;
+            }
+            if !allowed {
+                return Err(AuthError::InvalidKeyUsage);
+            }
+        }
+    }
+    if let Some(constraints) = cert.basic_constraints()?
+        && !constraints.ca
+        && constraints.path_len.is_some()
+    {
+        return Err(AuthError::CertificateNotCA);
+    }
+    cert.key_usage()?;
+    Ok(())
+}
