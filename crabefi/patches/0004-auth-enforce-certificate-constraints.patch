+/// Enforce each intermediate's delegation limit on the completed path.
+/// RFC 5280 counts non-self-issued CA certificates below that intermediate,
+/// excluding the end entity. Explicitly enrolled anchors are not constrained
+/// by their certificate extensions, matching Secure Boot's flat db trust.
+fn validate_path_lengths(chain: &[Vec<u8>]) -> Result<(), AuthError> {
+    for issuer_index in 1..chain.len().saturating_sub(1) {
+        if let Some(constraints) = extract_basic_constraints(&chain[issuer_index])?
+            && let Some(limit) = constraints.path_len
+        {
+            let mut subordinate_cas = 0usize;
+            for subordinate in &chain[1..issuer_index] {
+                let cert = parse_cert_view(subordinate)?;
+                if cert.subject != cert.issuer {
+                    subordinate_cas += 1;
+                }
+            }
+            if subordinate_cas > usize::from(limit) {
+                return Err(AuthError::ChainTooDeep);
+            }
+        }
+    }
+    Ok(())
+}
