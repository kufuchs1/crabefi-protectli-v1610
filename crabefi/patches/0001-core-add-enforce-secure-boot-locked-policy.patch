diff --git a/crabefi-core/src/lib.rs b/crabefi-core/src/lib.rs
index ea83150..d73d32c 100644
--- a/crabefi-core/src/lib.rs
+++ b/crabefi-core/src/lib.rs
@@ -182,6 +182,33 @@ const fn supports_capsule_delivery(
     writable_persistence && retained_staging_ready && backend_available
 }
 
+/// Refuse to continue unless the persisted key hierarchy put the platform in
+/// User Mode with Secure Boot enabled.
+///
+/// Image verification is already unconditional in this build, so an empty or
+/// unreadable store could only ever lead to "nothing boots". Halting here makes
+/// that failure explicit on the console instead of falling through to a boot
+/// menu, and guarantees no boot path runs against a key-less store.
+#[cfg(feature = "enforce-secure-boot")]
+fn enforce_locked_secure_boot(persistence_available: bool) {
+    let user_mode = !efi::auth::is_setup_mode();
+    let enabled = efi::auth::is_secure_boot_enabled();
+    if persistence_available && user_mode && enabled {
+        log::info!("Secure Boot: locked policy satisfied (User Mode, enforcing)");
+        return;
+    }
+    loop {
+        log::error!(
+            "Secure Boot: locked policy NOT satisfied (store={}, user_mode={}, enabled={}); \
+             refusing to boot. Reflash a ROM with a valid read-only variable store.",
+            persistence_available,
+            user_mode,
+            enabled
+        );
+        time::delay_ms(10_000);
+    }
+}
+
