 crabefi-core/src/lib.rs                      | 30 ++++++++++++++++++++
 crabefi-core/src/menu.rs                     |  7 +++--
 8 files changed, 79 insertions(+), 9 deletions(-)

diff --git a/crabefi-core/Cargo.toml b/crabefi-core/Cargo.toml
index 1016e43..609f2c6 100644
--- a/crabefi-core/Cargo.toml
+++ b/crabefi-core/Cargo.toml
@@ -16,6 +16,12 @@ xhci = ["dep:xhci"]
 tpm = ["dep:sha1"]
 # UEFI image/key authentication, independent of a host firmware's signed FFS.
 secure-boot = ["pkcs7", "crabefi-runtime-bundle?/secure-boot"]
+# Locked deployment policy: image verification is unconditional (it does not
+# depend on the mutable SecureBoot/SecureBootEnable state), default Microsoft
+# keys are never auto-enrolled, setup actions that weaken Secure Boot are
+# compiled out, and boot halts unless the persisted PK/KEK/db put the platform
+# in User Mode with Secure Boot enabled.
+enforce-secure-boot = ["secure-boot"]
 # Signed firmware capsule application requires durable result persistence.
 capsule-update = ["pkcs7", "variable-store"]
 # Shared verification implementation, not a runtime policy switch.
