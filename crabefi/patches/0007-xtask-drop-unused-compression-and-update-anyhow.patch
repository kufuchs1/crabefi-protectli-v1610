 serde_json = "1"
 sha2 = "0.10"
-object = { version = "0.40.0", features = ["read_core", "elf"] }
+# Runtime packaging reads ELF sections directly; compressed debug sections
+# are unnecessary. Keep the unused compression/format parsers out of the tool.
+object = { version = "0.40.0", default-features = false, features = ["read_core", "elf", "std"] }
 tempfile = "3"
