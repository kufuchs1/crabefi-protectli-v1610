 version = "1.0.4"
@@ -147,7 +137,6 @@ name = "crabefi-coreboot"
 version = "0.1.0"
 dependencies = [
  "acpi",
- "cc",
  "crabefi-core",
  "crabefi-hw",
  "crabefi-runtime-abi",
@@ -294,12 +283,6 @@ version = "0.1.5"
