@@ -1033,6 +1056,90 @@ mod fixture_tests {
     const SECURITY_LEAF: &[u8] = include_bytes!("testdata/security-leaf.der");
     const SECURITY_BAD_KU: &[u8] = include_bytes!("testdata/security-badku.der");
 
+    fn audit_wrap(tag: u8, value: &[u8]) -> Vec<u8> {
+        let mut result = vec![tag];
+        if value.len() < 128 {
+            result.push(value.len() as u8);
+        } else {
+            let length = value.len().to_be_bytes();
+            let length = &length[length.iter().take_while(|&&byte| byte == 0).count()..];
+            result.push(0x80 | length.len() as u8);
+            result.extend_from_slice(length);
+        }
+        result.extend_from_slice(value);
+        result
+    }
+
+    fn audit_repeat_cms_field(wanted_tag: u8, copies: usize) -> Vec<u8> {
+        let mut outer = Tlv::parse(CMS_ATTRS)
+            .unwrap()
+            .contents(tag::SEQUENCE)
+            .unwrap();
+        let oid = outer.read().unwrap();
+        let signed = outer.read().unwrap().inner().unwrap();
+        let mut fields: Vec<_> = signed
+            .contents(tag::SEQUENCE)
+            .unwrap()
+            .map(|field| field.unwrap())
+            .collect();
+        let at = fields
+            .iter()
+            .rposition(|field| field.tag == wanted_tag)
+            .unwrap();
+        let replacement = audit_wrap(wanted_tag, &fields[at].value.repeat(copies));
+        fields[at] = Tlv::parse(&replacement).unwrap();
+        let body: Vec<_> = fields
+            .iter()
+            .flat_map(|field| field.encoded.iter().copied())
+            .collect();
+        let explicit = audit_wrap(
+            tag::context_constructed(0),
+            &audit_wrap(tag::SEQUENCE, &body),
+        );
+        audit_wrap(tag::SEQUENCE, &[oid.encoded, &explicit].concat())
+    }
+
+    #[test]
+    fn audit_boot_cms_rejects_excessive_certificates() {
+        let cms = audit_repeat_cms_field(tag::context_constructed(0), 17);
+        assert!(verify_pkcs7_signature(&cms, DATA, CA, true).is_err());
+    }
+
+    #[test]
+    fn audit_boot_cms_rejects_excessive_signers() {
+        let cms = audit_repeat_cms_field(tag::SET, 9);
+        assert!(verify_pkcs7_signature(&cms, DATA, CA, true).is_err());
+    }
+
+    #[test]
+    fn audit_chain_depth_limit_applies_to_fast_paths() {
+        let config = ChainBuildingConfig {
+            max_depth: 1,
+            check_validity_period: false,
+            ..ChainBuildingConfig::default()
+        };
+        assert!(build_and_verify_chain(CA, CA, &[], &config).is_ok());
+        assert!(build_and_verify_chain(LEAF, CA, &[], &config).is_err());
+        let config = ChainBuildingConfig {
+            max_depth: 0,
+            ..config
+        };
+        assert!(build_and_verify_chain(CA, CA, &[], &config).is_err());
+    }
+
+    #[test]
+    fn audit_rsa_extraction_rejects_a_pss_restricted_spki() {
+        const RSA_OID: &[u8] = &[0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 1, 1, 1];
+        let mut cert = LEAF.to_vec();
+        let at = cert
+            .windows(RSA_OID.len())
+            .position(|w| w == RSA_OID)
+            .unwrap();
+        cert[at + RSA_OID.len() - 1] = 10; // RSASSA-PSS, not rsaEncryption
+        let parsed = Certificate::parse(&cert).unwrap();
+        assert!(parsed.rsa_public_key().is_err());
+    }
+
     #[test]
     fn recheck_rejects_mismatched_cms_content_type() {
         let mut cms = CMS_ATTRS.to_vec();
