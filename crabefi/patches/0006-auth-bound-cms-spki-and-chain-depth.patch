@@ -88,6 +90,10 @@ impl<'a> Certificate<'a> {
 
     /// Decode the subject public key as a PKCS#1 `RSAPublicKey`.
     pub fn rsa_public_key(&self) -> Result<RsaPublicKey<'a>> {
+        const RSA_ENCRYPTION: &[u8] = &[0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 1, 1, 1];
+        if !AlgorithmIdentifier::parse(self.public_key_algorithm)?.is(RSA_ENCRYPTION) {
+            return Err(DecodeError);
+        }
         RsaPublicKey::parse(self.public_key)
     }
 
