+    pub signature_algorithm: Tlv<'a>,
     pub signature: &'a [u8],
 }
 
@@ -141,7 +143,7 @@ impl<'a> SignerInfo<'a> {
             .read_optional(tag::context_constructed(0))?
             .map(SignedAttributes::parse)
             .transpose()?;
-        fields.read_tag(tag::SEQUENCE)?;
+        let signature_algorithm = fields.read_tag(tag::SEQUENCE)?;
         let signature = fields.read()?.octet_string()?;
         fields.read_optional(tag::context_constructed(1))?;
         fields.finish()?;
@@ -149,6 +151,7 @@ impl<'a> SignerInfo<'a> {
             identifier,
             digest_algorithm,
             signed_attributes,
+            signature_algorithm,
             signature,
         })
     }
diff --git a/crabefi-pkcs7/src/x509.rs b/crabefi-pkcs7/src/x509.rs
index 7bee8e3..b1ddcaf 100644
--- a/crabefi-pkcs7/src/x509.rs
+++ b/crabefi-pkcs7/src/x509.rs
@@ -40,7 +40,10 @@ impl<'a> Certificate<'a> {
         let mut tbs_fields = Reader::new(tbs.value);
         tbs_fields.read_optional(tag::context_constructed(0))?;
         let serial = tbs_fields.read()?.unsigned_integer()?;
-        tbs_fields.read_tag(tag::SEQUENCE)?;
+        let tbs_signature_algorithm = tbs_fields.read_tag(tag::SEQUENCE)?;
+        if tbs_signature_algorithm.encoded != signature_algorithm.encoded {
