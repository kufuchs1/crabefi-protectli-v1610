         let issuer = tbs_fields.read_tag(tag::SEQUENCE)?.encoded;
         let validity = tbs_fields.read_tag(tag::SEQUENCE)?.value;
         let subject = tbs_fields.read_tag(tag::SEQUENCE)?.encoded;
