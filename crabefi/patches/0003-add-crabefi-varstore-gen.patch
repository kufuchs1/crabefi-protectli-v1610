+[package]
+name = "crabefi-varstore-gen"
+version = "0.1.0"
+edition.workspace = true
+license.workspace = true
+repository.workspace = true
+description = "Build a pre-provisioned, read-only EDK2 variable store (PK/KEK/db) for locked CrabEFI ROMs"
+
+[dependencies]
+# Host build of the core library: only its pure EDK2 FV serializer/parser is used.
+crabefi = { package = "crabefi-core", path = "../crabefi-core", default-features = false }
+crabefi-efi-types = { workspace = true }
+crabefi-runtime-abi = { path = "../crabefi-runtime-abi" }
diff --git a/crabefi-varstore-gen/src/main.rs b/crabefi-varstore-gen/src/main.rs
