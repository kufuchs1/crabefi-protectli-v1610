# Sources for the Protectli V1610 CrabEFI ROM.

# --- coreboot: always resolve the latest remote main, never a fixed commit ---
COREBOOT_REPO="https://codeberg.org/kurtfuchs/coreboot.git"
COREBOOT_REF="main"

# --- board blobs ---
BLOBS_ARCHIVE_URL="https://git.fuchskurt.eu/api/v1/repos/kurtfuchs/coreboot-blobs/archive/main.tar.gz"

# --- CrabEFI: upstream plus checked-in deployment/security patches ---
# Upstream commit; crabefi/patches/ are applied on top (locked Secure Boot,
# read-only memory-mapped variable store, crabefi-varstore-gen).
CRABEFI_REPO="https://github.com/ArthurHeymans/CrabEFI.git"
CRABEFI_REF="2f0b0d7e7b4a19beae469e46ab4327bae6a817e5"
# Floating: always the current nightly, updated on every build.
CRABEFI_TOOLCHAIN="nightly"

# --- Secure Boot keys: secureblue's uki/keys, fetched at the current tip ---
# The :uki image copies the same uki/keys/*/*.auth and *.der into
# /usr/share/secureblue/uki/keys.
SECUREBLUE_REPO="https://github.com/secureblue/secureblue.git"
SECUREBLUE_REF="live"  # secureblue's default branch
SECUREBLUE_RAW="https://raw.githubusercontent.com/secureblue/secureblue"
# Trust anchor: SHA-256 of the DER "secureblue PK CA 2026" certificate. KEK
# and db must be signed through this PK (tools/verify-auth-chain.py), so they
# can rotate at the branch tip; a PK rotation needs a reviewed update here.
SECUREBLUE_PK_SHA256="c926342061304bbd97fcec3b3d879b15dcaadf3ef6b11235490e760104666ca6"
